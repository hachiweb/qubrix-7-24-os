{
  "name": "qubrix-cloudflare",
  "private": true,
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create qubrix-db",
    "db:init": "wrangler d1 execute qubrix-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute qubrix-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute qubrix-db --remote --file=./seed.sql",
    "db:seed:local": "wrangler d1 execute qubrix-db --local --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}